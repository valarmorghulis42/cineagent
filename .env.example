# Copy to .env (gitignored) and fill in real values, or export these directly in your shell.
# Spring Boot does not auto-load .env files -- source it yourself before starting the app:
#   export $(grep -v '^#' .env | xargs)
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=demo
#
# Every variable below has a safe default baked into application*.yml, so NONE of this is
# required to run the app locally on the default H2 profile. This file exists purely to
# document what's overridable and how, per the README's Configuration section.

# --- Identity (all profiles) ---
# HS256 signing secret for JWTs. Defaults to a committed dev-only value -- override before
# anything beyond local dev/demo. Must be at least 32 bytes.
JWT_SECRET=dev-only-insecure-secret-key-change-me-before-any-real-deployment-32bytes+

# --- AI: natural-language show search (optional) ---
# Off by default (app.ai.gemini.enabled=false) -- the deterministic keyword parser is what
# every test and an offline reviewer uses. Get a key at https://aistudio.google.com/apikey
# (starts with AIzaSy...), then run with:
#   -Dspring-boot.run.arguments="--app.ai.gemini.enabled=true"
# GeminiQueryInterpreter falls back to the deterministic parser on any failure -- a missing or
# invalid key here never breaks the /shows/search endpoint, it just quietly doesn't upgrade it.
GEMINI_API_KEY=

# --- Postgres profile only (--spring.profiles.active=postgres) ---
# Ignored entirely on the default H2 profile.
DB_URL=jdbc:postgresql://localhost:5432/cineagent
DB_USERNAME=cineagent
DB_PASSWORD=cineagent
